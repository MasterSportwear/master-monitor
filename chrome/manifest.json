{
  "manifest_version": 3,
  "name": "Master Monitor — Domínios do Chrome",
  "version": "2.1.0",
  "description": "Monitoramento informado do domínio da aba ativa. Requer o Master Monitor instalado e ativação explícita.",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": [
    "tabs",
    "nativeMessaging",
    "storage"
  ],
  "incognito": "not_allowed",
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Master Monitor — domínios"
  }
}
